<Window x:Class="StudentPerformance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота № 2 — Успішність студентів (XML)"
        Background="{StaticResource BgMainBrush}"
        Width="1180" Height="780" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок у стилі минулої MAUI-лаби -->
        <StackPanel Grid.Row="0" Margin="2,0,0,12">
            <TextBlock Text="Успішність студентів"
                       Foreground="{StaticResource TitleLavenderBrush}"
                       FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Аналіз XML-документів (SAX, DOM, LINQ to XML) та XSLT-трансформація у HTML"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12.5" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Верхня панель дій (лавандові кнопки, усе українською) -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="Обрати XML…" Margin="0,0,8,6" Click="OnPickFileClicked"/>
            <Button Content="Приклад" Margin="0,0,8,6" Click="OnLoadSampleClicked"/>
            <Button Content="Пошук" Margin="0,0,8,6" Click="OnSearchClicked"/>
            <Button Content="Трансформувати в HTML" Margin="0,0,8,6" Click="OnTransformHtmlClicked"/>
            <Button Content="Очистити" Margin="0,0,8,6" Click="OnClearClicked"/>
            <Button Content="Вихід" Margin="0,0,0,6" Click="OnExitClicked"/>
        </WrapPanel>

        <!-- Компактний рядок вибраного XML-файлу -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="XML-файл:" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentLavenderBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="FilePathTextBox" Grid.Column="1" IsReadOnly="True" Padding="8,4"/>
                <TextBlock x:Name="FileInfoText" Grid.Column="2"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="Оберіть файл або натисніть «Приклад»"/>
            </Grid>
        </Border>

        <!-- Основна робоча область: зліва параметри пошуку, справа велике вікно результатів -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ліва колонка: Стратегія, Ключове слово та Фільтри -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Спосіб аналізу (шаблон Strategy)" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLavenderBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="StrategyComboBox"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Пошук за ключовим словом" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLavenderBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="KeywordTextBox"
                                 ToolTip="Пошук без урахування регістру у значеннях усіх атрибутів"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Фільтри за атрибутами (з файлу)"
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentLavenderBrush}"
                                   Margin="0,0,0,8"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Атрибути студента" Foreground="{StaticResource TextMutedBrush}"
                                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <StackPanel x:Name="StudentAttrsPanel" Margin="0,0,0,10"/>

                                <TextBlock Text="Атрибути дисципліни" Foreground="{StaticResource TextMutedBrush}"
                                           FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <StackPanel x:Name="DisciplineAttrsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Права колонка: велике зручне вікно результатів аналізу на всю висоту -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Результат аналізу" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentLavenderBrush}"
                               FontSize="14" Margin="0,0,0,8"/>

                    <TextBox x:Name="OutputTextBox" Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Stretch"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13.5"
                             Padding="10,8"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
